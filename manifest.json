{
  "manifest_version": 3,
  "name": "LISA - AI Chat Exporter for Claude, ChatGPT & More",
  "version": "0.53.2",
  "description": "Export, compress, save and hand off AI chats across 12 platforms. One key and credit balance with LISA Nexus and Inference Shield.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus",
    "notifications",
    "identity",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://chat.deepseek.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://*.perplexity.ai/*",
    "https://api.sat-chain.com/*",
    "https://nexus.sat-chain.com/*",
    "https://lisa-web-backend-production.up.railway.app/*",
    "https://shield.sat-chain.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icon16.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/code/*"
      ],
      "js": [
        "src/content/lisa-progressive.js",
        "src/content/claude-code-parser.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/content/claude-api-capture.js",
        "src/content/claude-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content/chatgpt-api-capture.js",
        "src/content/chatgpt-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content/gemini-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://grok.com/*"
      ],
      "js": [
        "src/content/grok-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "src/content/mistral-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "src/content/deepseek-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*"
      ],
      "js": [
        "src/content/copilot-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.perplexity.ai/*"
      ],
      "js": [
        "src/content/perplexity-api-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.perplexity.ai/*"
      ],
      "js": [
        "src/content/perplexity-api-capture.js",
        "src/content/perplexity-parser.js",
        "src/content/lisa-progressive.js",
        "src/shared/html-to-markdown.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://huggingface.co/chat/*"
      ],
      "js": [
        "src/shared/html-to-markdown.js",
        "src/content/huggingchat-parser.js",
        "src/content/lisa-progressive.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://meta.ai/*"
      ],
      "js": [
        "src/shared/html-to-markdown.js",
        "src/content/metaai-parser.js",
        "src/content/lisa-progressive.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poe.com/*"
      ],
      "js": [
        "src/shared/html-to-markdown.js",
        "src/content/poe-parser.js",
        "src/content/lisa-progressive.js",
        "src/content/lisa-v-parser.js",
        "src/shared/conversation-id.js",
        "src/shared/checkpoint-detect.js",
        "src/content/acm-monitor.js",
        "src/content/lisa-floating-button.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://shield.sat-chain.com/app*"
      ],
      "js": [
        "src/content/shield-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src https://api.sat-chain.com https://nexus.sat-chain.com https://lisa-web-backend-production.up.railway.app"
  },
  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/popup/*"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://*.perplexity.ai/*"
      ]
    }
  ],
  "oauth2": {
    "client_id": "288694505034-n3i0v69lsarh505q35cos8m4n2v6cqnj.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
